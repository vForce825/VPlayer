--disable-autodetect
--disable-programs
--disable-doc
--disable-debug
--disable-avdevice
--disable-avfilter
--disable-swscale
--disable-network
--disable-everything
--disable-gpl
--disable-nonfree
--disable-version3
--disable-shared
--enable-static
--enable-pic
--enable-small
--enable-network
--enable-avcodec
--enable-avformat
--enable-avutil
--enable-swresample
--enable-securetransport
--enable-zlib
--enable-protocol=http,https,tcp,tls,crypto,data
--enable-demuxer=mpegts,hls,mov
--enable-parser=h264,hevc,aac,aac_latm,ac3,mpegaudio
--enable-bsf=h264_mp4toannexb,hevc_mp4toannexb
--enable-decoder=aac,ac3,eac3,h264,mp1,mp2,mp3
